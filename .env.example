# Скопируйте этот файл в .env.local и укажите ключ, чтобы включить реальный ИИ.
# Без ключа приложение работает в демо-режиме (заготовленные ответы, без интернета).

# Вариант 1 — Claude (Anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Вариант 2 — OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
